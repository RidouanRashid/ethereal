# Laat Apache (XAMPP) de gebouwde versie uit dist/ tonen op http://localhost/etheral/.
# De broncode in de hoofdmap werkt niet rechtstreeks in de browser, omdat de imports
# (ogl, gsap, lenis) eerst door Vite gebundeld moeten worden.
# Na een wijziging: `npm run build`, daarna de pagina verversen.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !/dist/
  RewriteRule ^(.*)$ dist/$1 [L]
</IfModule>
